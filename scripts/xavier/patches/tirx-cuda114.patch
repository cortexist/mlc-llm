 #include <cuda.h>
 #include <cuda_runtime.h>
 
+// ---- CUDA < 11.8 compatibility (JetPack 5 / CUDA 11.4; local patch, see ~/Workspaces/mlc-jp5) ----
+// Extended launches (cuLaunchKernelEx, launch attributes, thread-block clusters) appeared in CUDA 11.8.
+// Every launch attribute TVM encodes is gated on CUDA >= 12.0, so with an older toolkit the attribute
+// list is always empty and an extended launch is exactly a classic launch. Cluster requests fail loudly.
+#if defined(CUDA_VERSION) && CUDA_VERSION < 11080
+typedef struct CUlaunchAttribute_st {
+  int id;
+  union {
+    char pad[64];
+  } value;
+} CUlaunchAttribute;
+typedef struct CUlaunchConfig_st {
+  unsigned int gridDimX, gridDimY, gridDimZ;
+  unsigned int blockDimX, blockDimY, blockDimZ;
+  unsigned int sharedMemBytes;
+  CUstream hStream;
+  CUlaunchAttribute* attrs;
+  unsigned int numAttrs;
+} CUlaunchConfig;
+// Not a valid attribute on this toolkit: the driver rejects it, so cluster launches error out.
+#define CU_FUNC_ATTRIBUTE_NON_PORTABLE_CLUSTER_SIZE_ALLOWED CU_FUNC_ATTRIBUTE_MAX
+inline CUresult cuLaunchKernelEx(const CUlaunchConfig* config, CUfunction f, void** params,
+                                 void** extra) {
+  if (config->numAttrs != 0) return CUDA_ERROR_NOT_SUPPORTED;
+  return cuLaunchKernel(f, config->gridDimX, config->gridDimY, config->gridDimZ, config->blockDimX,
+                        config->blockDimY, config->blockDimZ, config->sharedMemBytes,
+                        config->hStream, params, extra);
+}
+#endif
+#if defined(CUDART_VERSION) && CUDART_VERSION < 11080
+typedef struct cudaLaunchAttribute_st {
+  int id;
+  union {
+    char pad[64];
+  } val;
+} cudaLaunchAttribute;
+typedef struct cudaLaunchConfig_st {
+  dim3 gridDim;
+  dim3 blockDim;
+  size_t dynamicSmemBytes;
+  cudaStream_t stream;
+  cudaLaunchAttribute* attrs;
+  unsigned int numAttrs;
+} cudaLaunchConfig_t;
+#define cudaFuncAttributeNonPortableClusterSizeAllowed cudaFuncAttributeMax
+inline cudaError_t cudaLaunchKernelExC(const cudaLaunchConfig_t* config, const void* func,
+                                       void** args) {
+  if (config->numAttrs != 0) return cudaErrorNotSupported;
+  return cudaLaunchKernel(func, config->gridDim, config->blockDim, args, config->dynamicSmemBytes,
+                          config->stream);
+}
+#endif
+// ---- end CUDA < 11.8 compatibility ----
+
